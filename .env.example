# Resend (https://resend.com) — envoi des emails déclenchés par les formulaires du site.
# Sans cette clé, les formulaires fonctionnent toujours mais les envois sont simulés
# (journalisés côté serveur uniquement, aucun email réel n'est envoyé).
RESEND_API_KEY=

# Adresse d'expédition. Doit provenir d'un domaine vérifié dans Resend,
# ou de l'adresse bac à sable "onboarding@resend.dev" en attendant la vérification.
RESEND_FROM_EMAIL="SOGA — Site institutionnel <onboarding@resend.dev>"

# Adresse qui reçoit toutes les notifications de formulaires.
CONTACT_EMAIL_TO=direction@senegaloilandgasacademy.com
